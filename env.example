NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
WARETRACK_ENV=development
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./waretrack.db

# Explicit bootstrap opt-in for local/dev admin creation.
# Only set these when you intentionally want to create a privileged admin account.
WARETRACK_BOOTSTRAP_ADMIN=false
WARETRACK_ADMIN_EMAIL=admin@waretrack.local
WARETRACK_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
